{
  "name": "playwright-browser-skill",
  "version": "2.1.0",
  "description": "A powerful browser automation skill for OpenClaw, providing 101 complete browser operations through MCP protocol",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "playwright-browser-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/mcp-server.js",
    "install-browsers": "npx playwright install",
    "test": "npm run build && node test/run-all-tests.js",
    "test:basic": "npm run build && node test/basic-test.js",
    "test:advanced": "npm run build && node test/advanced-test.js",
    "test:interaction": "npm run build && node test/interaction-test.js",
    "test:mcp": "npm run build && node test/mcp-server-test.js"
  },
  "keywords": [
    "openclaw",
    "kiro",
    "skill",
    "playwright",
    "browser",
    "automation",
    "mcp",
    "web-scraping",
    "testing",
    "headless-browser"
  ],
  "author": "91fapiao <91fapiao@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/91fapiao-cn/playwright-browser-skill.git"
  },
  "bugs": {
    "url": "https://github.com/91fapiao-cn/playwright-browser-skill/issues"
  },
  "homepage": "https://github.com/91fapiao-cn/playwright-browser-skill#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
